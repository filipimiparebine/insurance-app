# =============================================================================
# Insurtech Platform - Environment Variables
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- GCP Cloud KMS (Key Management) ---
# Provisioned by: TEC-15 | Region: europe (multi-region)
GCP_PROJECT_ID=
GCP_KMS_KEY_RING=insurtech-keyring-prod
GCP_KMS_KEK_NAME=insurtech-kek-prod
GCP_KMS_KEK_RESOURCE=

# --- Hetzner S3 Object Storage ---
# Provisioned by: TEC-15 | Region: fsn1 (Falkenstein, Germany)
HETZNER_S3_ENDPOINT=https://fsn1.your-objectstorage.com
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_S3_REGION=fsn1

# S3 Bucket Names
S3_DOCUMENTS_BUCKET=insurtech-prod-documents
S3_BACKUPS_BUCKET=insurtech-prod-backups
S3_STATIC_BUCKET=insurtech-prod-static
S3_STATIC_PUBLIC_URL=https://fsn1.your-objectstorage.com/insurtech-prod-static

# --- Upstash Redis (Serverless) ---
# Provisioned by: TEC-15 | Region: eu-central-1 (Frankfurt, Germany)
UPSTASH_QUOTES_REDIS_URL=
UPSTASH_QUOTES_REDIS_TOKEN=
UPSTASH_RATELIMIT_REDIS_URL=
UPSTASH_RATELIMIT_REDIS_TOKEN=

# --- Neon Postgres ---
# Provisioned by: TEC-14 | Region: eu-central-1 (Frankfurt)
# Provision: neonctl projects create --name blaj --region-id aws-eu-central-1
# Then: neonctl databases create --name blaj --project-id <project-id>
# DATABASE_URL format: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/blaj?sslmode=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Superadmin Access ---
# Comma-separated list of email addresses that get admin panel access
SUPERADMIN_EMAILS=

# Admin panel URL for superadmin redirects from the web app
NEXT_PUBLIC_ADMIN_URL=

# --- Stripe Payments ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend Email (EU) ---
RESEND_API_KEY=

# --- Twilio SMS (EU) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Vercel Deployment ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Observability ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
AXIOM_TOKEN=

# --- Google Document AI ---
# Region: europe-west3 (Frankfurt)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# --- Application ---
NEXT_PUBLIC_APP_URL=https://blaj.io
NEXT_PUBLIC_API_URL=https://api.blaj.io
