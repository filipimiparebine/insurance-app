{
  "name": "@blaj/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./openapi": "./src/openapi.ts",
    "./lib/stripe": "./src/lib/stripe.ts",
    "./lib/resend": "./src/lib/resend.ts",
    "./lib/twilio": "./src/lib/twilio.ts",
    "./lib/s3": "./src/lib/s3.ts",
    "./lib/pdf": "./src/lib/pdf.ts",
    "./lib/encryption": "./src/lib/encryption.ts",
    "./lib/keygen": "./src/lib/keygen.ts",
    "./lib/expo-push": "./src/lib/expo-push.ts",
    "./services/notifications": "./src/services/notifications.ts",
    "./services/policy-engine": "./src/services/policy-engine.ts",
    "./services/reminders": "./src/services/reminders.ts",
    "./services/insurers": "./src/services/insurers/index.ts",
    "./webhooks/clerk": "./src/webhooks/clerk.ts",
    "./webhooks/stripe": "./src/webhooks/stripe.ts"
