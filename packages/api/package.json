    "@blaj/security": "workspace:*",
    "@blaj/shared": "workspace:*",
    "@orpc/client": "^1.0.0",
    "@orpc/contract": "^1.0.0",
    "@orpc/openapi": "^1.0.0",
    "@orpc/server": "^1.0.0",
    "@orpc/zod": "^1.0.0",
    "@types/pdfmake": "^0.3.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.39.3",
    "expo-server-sdk": "^6.1.0",
    "libsodium-wrappers": "^0.7.15",
    "pdfmake": "^0.3.8",
    "resend": "^4.1.0",
    "stripe": "^17.5.0",
    "svix": "^1.45.0",
    "twilio": "^5.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@blaj/eslint-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
