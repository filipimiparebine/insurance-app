# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Override files (local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Terraform lock file (commit this for version pinning)
# .terraform.lock.hcl

# TF plan files
*.tfplan

# Environment files
.env
.env.*
!.env.example

# Terraform variable files with secrets (ALL tfvars except examples)
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# MacOS
.DS_Store
